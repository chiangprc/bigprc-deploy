server {
    listen 443 ssl;
    server_name www.bigprc.com;

    charset utf-8;

    root /var/www/site/web;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/www.bigprc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.bigprc.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ==== 百度验证专属 VIP 直出通道 ====
    location = /baidu_verify_codeva-aoxFXTkapa.html {
        access_log off;
        default_type text/plain;
        charset utf-8;
        return 200 'codeva-aoxFXTkapa';
    }

    # ������【最关键】精确匹配 /ws（必须放最前）
    location = /ws {
        proxy_pass http://127.0.0.1:18789;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # ������ 兼容 /ws/
    location ^~ /ws/ {
        proxy_pass http://127.0.0.1:18789/;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # ������ 自动化跳转规则
    location /jump/ {
        include /etc/nginx/snippets/jump_rules.conf;
        return 302 https://www.bigprc.com;
    }

    # 首页（SPA 防吞路径）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态目录
    location /static/ {
        autoindex off;
    }

    # go 中转
    location /go/ {
        try_files $uri $uri/ @rewrite_go;
    }

    location @rewrite_go {
        rewrite ^/go/(.*)$ /static/page/$1.html break;
    }
}

server {
    listen 80;
    server_name www.bigprc.com;

    # ==== 百度验证专属 VIP 直出通道 (HTTP 同步放行) ====
    location = /baidu_verify_codeva-aoxFXTkapa.html {
        access_log off;
        default_type text/plain;
        charset utf-8;
        return 200 'codeva-aoxFXTkapa';
    }

    # 其他请求依然强制跳转 HTTPS
    location / {
        return 301 https://www.bigprc.com$request_uri;
    }
}
