server {
    listen 80;
    listen 443 ssl;
    server_name claw.bigprc.com;

    # 借用你已经配置好的证书
    ssl_certificate /etc/letsencrypt/live/bigprc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bigprc.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:18789;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
